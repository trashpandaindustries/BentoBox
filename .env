CLIP_MODEL_ID=openai/clip-vit-base-patch32
CLIP_MEMORY=4Gi
CLIP_PORT=3000
# adjust for your setup
CLIP_CORS_ORIGINS=http://192.168.1.69:8080
# CLIP_FORCE_DEVICE=cpu
 
# Florence-2 captioning (ingestion-time only) — off by default.
# CLIP_MEMORY above is shared by both models when this is on; bump it
# (e.g. 6Gi-8Gi for Florence-2-base, more for -large) before enabling.
FLORENCE_ENABLED=true
FLORENCE_MODEL_ID=microsoft/Florence-2-base
# Recommended once FLORENCE_ENABLED=true — pin to a specific commit hash
# rather than trusting main, since trust_remote_code=True executes repo code.
# FLORENCE_MODEL_REVISION=
 
